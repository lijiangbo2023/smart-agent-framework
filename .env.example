# ============================================
# Smart Agent Framework 环境变量配置
# 复制此文件为 .env 并填入实际值
# ============================================

# ---- LLM (DashScope) - 必须 ----
# 在 https://dashscope.console.aliyun.com/ 获取
LLM_API_KEY=sk-your-dashscope-api-key
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_MODEL=qwen-max
LLM_FAST_MODEL=qwen-turbo

# ---- 数据库 (MySQL) - 必须 ----
DB_HOST=localhost
DB_PORT=3306
DB_NAME=smart_agent
DB_USERNAME=root
DB_PASSWORD=changeme

# ---- Redis - 可选 ----
# 配置后自动激活：分布式会话锁 / Session缓存 / Token共享 / API限流 / 消息去重
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=smart-agent-redis

# ---- 环境切换 ----
# local=本地开发 | dev=日常 | staging=预发 | prod=线上
SPRING_PROFILES_ACTIVE=local

# ---- 钉钉机器人 - 可选 ----
# 设置为 true 启用，需先在 Nacos 或 Diamond 中配置 appKey/appSecret/robotCode
DINGTALK_STREAM_ENABLED=false

# ---- Nacos 配置中心 - 可选 ----
NACOS_SERVER_ADDR=127.0.0.1:8848

# ---- Milvus 向量数据库 (RAG) - 可选 ----
MILVUS_URI=http://localhost:19530

# ---- MCP Server - 可选 ----
# MCP_SERVER_URL=http://localhost:3000/sse
# MCP_SERVER_NAME=my-mcp-server

# ---- Skill 配置 ----
# 本地开发：设置本地目录（仅 local profile 生效）
SKILL_LOCAL_DIR=./skills-repo
# 日常/预发/线上：设置 Git 仓库地址和 Token
SKILL_GIT_REPO_URL=https://github.com/YOUR_USER/smart-agent-framework-skills.git
SKILL_GIT_TOKEN=ghp_xxxxxxxxxxxx
SKILL_GIT_USERNAME=oauth2
SKILL_GIT_BRANCH=main

# ---- API 限流 (需 Redis) ----
RATELIMIT_REQUESTS_PER_MINUTE=30

# ---- 认证 ----
# local/dev 环境默认关闭，staging/prod 需配置
AUTH_ENABLED=false
AUTH_API_KEY=change-this-api-key
AUTH_JWT_SECRET=your-jwt-secret-key-change-me

# ---- CORS ----
# local 环境默认 *，staging/prod 必须配置具体域名
CORS_ALLOWED_ORIGINS=http://localhost:5173

# ---- 数据清理 ----
CLEANUP_SESSION_RETENTION_DAYS=7
CLEANUP_MESSAGE_RETENTION_DAYS=90
