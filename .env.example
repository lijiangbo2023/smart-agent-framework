# Smart Agent Framework 环境变量配置
# 复制此文件为 .env 并填入实际值

# LLM (DashScope) - 必须
LLM_API_KEY=sk-your-dashscope-api-key
# LLM_SUB_API_KEY=sk-another-api-key

# 数据库
DB_HOST=localhost
DB_PORT=3306
DB_USERNAME=root
DB_PASSWORD=your-password

# Nacos（可选）
# NACOS_SERVER_ADDR=127.0.0.1:8848

# Milvus（可选，RAG 功能需要）
# MILVUS_URI=http://localhost:19530
# MILVUS_TOKEN=

# MCP Server（可选）
# MCP_SERVER_URL=http://localhost:3000/sse
# MCP_SERVER_NAME=my-mcp-server
