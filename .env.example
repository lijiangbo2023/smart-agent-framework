# Smart Agent Framework 环境变量配置
# 复制此文件为 .env 并填入实际值

# LLM (DashScope) - 必须
LLM_API_KEY=sk-your-dashscope-api-key
# LLM_SUB_API_KEY=sk-another-api-key

# 数据库
DB_HOST=localhost
DB_PORT=3306
DB_USERNAME=root
DB_PASSWORD=changeme

# Nacos（可选）
# NACOS_SERVER_ADDR=127.0.0.1:8848

# Milvus（可选，RAG 功能需要）
# MILVUS_URI=http://localhost:19530
# MILVUS_TOKEN=

# MCP Server（可选）
# MCP_SERVER_URL=http://localhost:3000/sse
# MCP_SERVER_NAME=my-mcp-server

# 钉钉机器人 Stream 模式（设置为 true 启用钉钉机器人）
DINGTALK_STREAM_ENABLED=false

# 数据清理（可选，以下为默认值）
# CLEANUP_SESSION_RETENTION_DAYS=7
# CLEANUP_MESSAGE_RETENTION_DAYS=90

# Redis（可选）
# 配置后自动激活：分布式会话锁、Session 缓存、Token 共享缓存、API 限流、消息去重
# REDIS_HOST=localhost
# REDIS_PORT=6379
# REDIS_PASSWORD=

# API 限流（需 Redis，以下为默认值）
# RATELIMIT_REQUESTS_PER_MINUTE=30
